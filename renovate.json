{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "assignees": ["PixiBixi"],
  "semanticCommits": "enabled",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Automerge all safe updates (minor/patch/digest) via PR once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Minor Go module bumps ship in the binary -> cut a minor release",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "feat"
    },
    {
      "description": "Patch/digest Go module bumps ship in the binary -> cut a patch release",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "digest"],
      "semanticCommitType": "fix"
    },
    {
      "description": "GitHub Actions updates do not ship in the binary -> no release",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "chore"
    },
    {
      "description": "Go toolchain updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "go-toolchain"
    },
    {
      "description": "Kubernetes modules share a v0.x release train and must move in lockstep; batch them into one PR",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "svu is pinned as a plain env var in the release workflow, which no built-in manager sees",
      "fileMatch": ["^\\.github/workflows/release\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)\\s+SVU_VERSION: (?<currentValue>.+?)\\s"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
